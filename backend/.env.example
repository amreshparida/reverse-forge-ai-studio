# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (default): file:./dev.db
# PostgreSQL: postgresql://user:password@localhost:5432/re_ai
DATABASE_URL="file:./dev.db"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Required when HOST is not loopback. Protects /api and /static with Bearer or X-API-Key auth.
# API_AUTH_TOKEN=replace-with-a-long-random-token

# ─── Output directory ────────────────────────────────────────────────────────
OUTPUT_DIR=./project-output

# ─── Session storage ─────────────────────────────────────────────────────────
SESSION_DIR=./sessions

# ─── LLM / AI Analysis ───────────────────────────────────────────────────────
#
# REQUIRED for AI analysis:
#   LLM_API_KEY  — your OpenAI API key (sk-...)
#
# OPTIONAL — only needed when using a provider other than OpenAI:
#   LLM_BASE_URL — custom API base URL (leave blank for OpenAI)
#   LLM_MODEL    — model name (default: gpt-4o-mini)
#
# Examples:
#   OpenAI (default)  → just set LLM_API_KEY, leave LLM_BASE_URL blank
#   Ollama (local)    → LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=llama3
#   Azure OpenAI      → LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deploy>   LLM_API_KEY=<azure-key>
#   Groq              → LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_API_KEY=<groq-key>   LLM_MODEL=llama-3.1-70b-versatile
#   LM Studio         → LLM_BASE_URL=http://localhost:1234/v1   LLM_API_KEY=lm-studio

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=   # uncomment and set only for non-OpenAI providers

# ─── Crawler defaults ────────────────────────────────────────────────────────
CRAWL_TIMEOUT_MS=30000
CRAWL_DELAY_MS=1000
CRAWL_MAX_CONCURRENCY=2
CRAWL_HEADLESS=false
# Agentic crawl max LLM actions (default 150). Steps ≠ unique pages.
AGENT_MAX_STEPS=150
# Maximum length of a human-guided manual crawl before automatic finalization.
MANUAL_CRAWL_MAX_MINUTES=240
# After page-analysis: local file-tool synthesis agent (Cursor-style). Set false for legacy one-shot JSON prompts.
SYNTHESIS_AGENT=true
# LLM turns per entity/workflow/permission stage (each turn can call several tools). Raise for accuracy.
SYNTHESIS_AGENT_MAX_STEPS=120
# Hard ceiling when the agent auto-extends steps to finish coverage (default 3000).
# SYNTHESIS_AGENT_MAX_STEPS_CEILING=3000
# Optional separate OpenAI-compatible endpoint for synthesis only (keeps page-analysis on LLM_*).
# Example — NVIDIA NIM:
# SYNTHESIS_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# SYNTHESIS_LLM_API_KEY=nvapi-...
# SYNTHESIS_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# SYNTHESIS_LLM_BASE_URL=
# SYNTHESIS_LLM_API_KEY=
# SYNTHESIS_LLM_MODEL=

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
